---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<Layout title="AI Tools Gids — Eerlijke vergelijkingen van AI-tools">
  <h1>AI Tools Gids</h1>
  <p>Praktische, feitelijke vergelijkingen van AI-tools voor freelancers en kleine bedrijven — zonder verzonnen reviews of testimonials.</p>

  {articles.length === 0 && (
    <p class="card">Nog geen artikelen. Draai <code>npm run generate</code> om het eerste artikel te genereren.</p>
  )}

  <ul style="list-style:none; padding:0;">
    {articles.map((article) => (
      <li class="card" style="margin-bottom:1rem;">
        <h2 style="margin:0 0 0.25rem;"><a href={`/articles/${article.id}`}>{article.data.title}</a></h2>
        <p style="margin:0; color:var(--muted);">{article.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>
